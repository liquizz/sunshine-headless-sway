[Unit]
Description=Headless Sway session for Sunshine streaming
After=graphical-session.target

[Service]
Type=simple
Environment=WLR_BACKENDS=headless,libinput
Environment=LIBSEAT_BACKEND=noop
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_RENDERER=gles2
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=WAYLAND_DISPLAY=wayland-1
Environment=SWAYSOCK=%t/sway-sunshine.sock
Environment=PULSE_SINK=sunshine_headless_audio
ExecStartPre=-/usr/bin/rm -f %t/sway-sunshine.sock
ExecStart=/usr/bin/sway --unsupported-gpu --config %h/.config/sway-sunshine/config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
