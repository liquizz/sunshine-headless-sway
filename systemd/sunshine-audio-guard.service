[Unit]
Description=Preserve the host audio output during headless Sunshine streaming
After=pipewire-pulse.service

[Service]
Type=simple
ExecStartPre=/usr/bin/bash -c 'for i in {1..30}; do pactl info >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/bash %h/.config/sway-sunshine/protect-host-audio.sh
Restart=on-failure
RestartSec=1s
