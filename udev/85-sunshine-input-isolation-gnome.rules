# Tell Mutter/GNOME to ignore Sunshine virtual input devices while retaining
# per-user access for the separate headless Sway compositor. The installer
# replaces __USER__ with the account running the headless session.
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{id/vendor}=="beef", ATTRS{id/product}=="dead", ENV{mutter-device-ignore}="1", OWNER="__USER__", MODE="0600", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{id/vendor}=="054c", ATTRS{id/product}=="0ce6", ENV{mutter-device-ignore}="1", OWNER="__USER__", MODE="0600", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{id/vendor}=="045e", ATTRS{id/product}=="0b13", ENV{mutter-device-ignore}="1", OWNER="__USER__", MODE="0600", TAG+="uaccess"
