{
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin",
    "WAYLAND_DISPLAY": "wayland-1",
    "PULSE_SINK": "sunshine_headless_audio",
    "SWAYSOCK": "/run/user/1000/sway-sunshine.sock"
  },
  "apps": [
    {
      "name": "Headless Desktop",
      "image-path": "desktop.png",
      "prep-cmd": [
        {
          "do": "systemctl --user start sunshine-audio-guard.service",
          "undo": "systemctl --user stop sunshine-audio-guard.service"
        },
        {
          "do": "/home/YOUR_USER/.config/sway-sunshine/set-resolution.sh",
          "undo": "/home/YOUR_USER/.config/sway-sunshine/reset-resolution.sh"
        }
      ]
    },
    {
      "name": "Steam Big Picture (Headless)",
      "detached": [
        "/home/YOUR_USER/.config/sway-sunshine/start-steam-game.sh bigpicture"
      ],
      "prep-cmd": [
        {
          "do": "systemctl --user start sunshine-audio-guard.service",
          "undo": "systemctl --user stop sunshine-audio-guard.service"
        },
        {
          "do": "/home/YOUR_USER/.config/sway-sunshine/set-resolution.sh",
          "undo": "/home/YOUR_USER/.config/sway-sunshine/stop-steam-game.sh"
        }
      ],
      "image-path": "steam.png"
    },
    {
      "name": "Steam (Headless)",
      "detached": [
        "/home/YOUR_USER/.config/sway-sunshine/start-steam-game.sh 0"
      ],
      "prep-cmd": [
        {
          "do": "systemctl --user start sunshine-audio-guard.service",
          "undo": "systemctl --user stop sunshine-audio-guard.service"
        },
        {
          "do": "/home/YOUR_USER/.config/sway-sunshine/set-resolution.sh",
          "undo": "/home/YOUR_USER/.config/sway-sunshine/stop-steam-game.sh"
        }
      ],
      "image-path": "steam.png"
    }
  ]
}
